# Backend API base (with /api prefix). Examples:
# VITE_API_URL=http://localhost:4000/api
# VITE_API_URL=https://fergana-roses-production.up.railway.app/api
VITE_API_URL=http://localhost:4000/api

# Optional: public S3 info if you serve images directly (backend presigns by default)
# VITE_S3_BUCKET_NAME=
# VITE_S3_REGION=
